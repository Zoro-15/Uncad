{
  "name": "lennister-player",
  "version": "1.0.0",
  "type": "module",
  "description": "Lennister Player - Multi-Course telemetric whiteboard streaming player",
  "scripts": {
    "dev": "vite --port 3000 --host",
    "dev:ioqm": "vite ramanujan-20-ioqm-2026 --port 3001 --host --open",
    "dev:sub": "vite --port 3000 --open /ramanujan-20-ioqm-2026/",
    "build": "vite build",
    "preview": "vite preview",
    "audit": "node scripts/audit_project.cjs",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "vite": "^4.5.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  }
}
