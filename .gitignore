# ══════════════════════════════════════════════════════════════════════
# Comprehensive .gitignore for Lennister Player / Vercel Web Deployment
# ══════════════════════════════════════════════════════════════════════

# ─── 1. Package Manager & Dependencies ───
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.npm/
.pnpm-store/
package-lock.json.bak

# ─── 2. Build Outputs & Deployment Artifacts ───
dist/
dist-ssr/
build/
out/
.output/
.vercel/
.next/
.nuxt/

# ─── 3. Caches, Bundler Internals & Temp Files ───
.cache/
.vite/
.parcel-cache/
.turbo/
.eslintcache/
.tmp/
.temp/
temp/
tmp/
scratch/
*.tmp
*.temp

# ─── 4. Raw Data Dumps, Scraped Files & Text Notes ───
*.txt
new txt/
1_*.html
nexus_*.html
*.dump.html
*.dump
*.jsonl
*.csv
*.tsv
*.sqlite
*.db
*.md
!README.md
!FUTURE.md

# ─── 5. Offline Scripts & Local Cache Files ───
scripts/
*.cjs
*cache*.json
*.cache

# ─── 6. Video, Audio, Document & Slide Downloads ───
downloads/
*.webm
*.mp4
*.mkv
*.avi
*.mov
*.flv
*.mp3
*.wav
*.aac
*.m4a
*.ogg
*.pdf

# ─── 7. Compressed Archives & Backups ───
*.zip
*.tar
*.tar.gz
*.gz
*.rar
*.7z
*.bak
*.backup
*~

# ─── 8. Environment Variables & Secrets ───
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# ─── 9. Logs & Debug Reports ───
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ─── 10. IDE, Editor & OS System Metadata ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.sw?
*.swp
*.swo
*.suo
*.sln
*.njsproj
*.ntvs*

# ─── 11. Testing & Agent Local Storage ───
coverage/
.nyc_output/
cypress/videos/
cypress/screenshots/
.gemini/
.agents/
.system_generated/
.antigravity/

# ─── 12. Subprojects / Batch Folders ───
ramanujan-20-ioqm-2026/

